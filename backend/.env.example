# Скопируй в .env и заполни. Файл .env в репозиторий НЕ коммитить.

# Токен бота из @MasterBot (команда /create в MAX)
MAX_TOKEN=

# user_id менеджера — узнать через: MAX_TOKEN=... node capture-id.js
MANAGER_USER_ID=

# Порт, на котором слушает сервер
PORT=8787

# Домен сайта для CORS (можно оставить * пока не привязан домен)
ALLOWED_ORIGIN=*

# Путь к сертификатам Минцифры (root+intermediate одним файлом).
# Нужно, потому что MAX перешёл на российские сертификаты, а Node
# по умолчанию их не доверяет. Раскомментируй после установки (см. README):
# NODE_EXTRA_CA_CERTS=/opt/perfecto/russian-ca.pem
