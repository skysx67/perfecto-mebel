# Скопируй в .env и заполни. Файл .env в репозиторий НЕ коммитить (он в .gitignore).

# Токен бота MAX (из @MasterBot: команда /create). Секрет.
MAX_TOKEN=

# user_id менеджера, кому падают заявки — узнать через: npm run capture-id
# (менеджер сначала открывает бота в MAX и жмёт «Начать»)
MANAGER_USER_ID=

# Порт локального сервера
PORT=8787

# Домен сайта для CORS. Пока * — можно оставить; на проде укажи свой домен,
# например: https://перфекто-мебель.рф
ALLOWED_ORIGIN=*

# Ключ для просмотра заявок в браузере: GET /leads?key=<ADMIN_KEY>
# Пусто = эндпоинт выключен (рекомендуется, если не нужен).
ADMIN_KEY=

# Путь к базе SQLite (по умолчанию ./leads.db). Обычно менять не нужно.
# DB_FILE=/opt/perfecto/leads.db

# ── РЕЗЕРВНАЯ ПОЧТА ──────────────────────────────────────────────────────────
# Если бот MAX недоступен, заявка дублируется письмом, а потом всё равно
# уходит в MAX автоматически, как только бот заработает.
# Оставь SMTP_PASS пустым — резерв просто выключен (заявки всё равно копятся в базе).
#
# Для mail.ru: Почта → Настройки → «Пароли для внешних приложений» → создать пароль.
# Это НЕ пароль от ящика, а отдельный, его можно в любой момент отозвать.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=perfecto72@mail.ru
SMTP_PASS=
# Куда слать письма (по умолчанию — тот же ящик)
MAIL_TO=perfecto72@mail.ru

# Как часто повторять отправку недоставленных заявок, мс (по умолчанию 2 минуты)
# RETRY_MS=120000

# Сертификаты Минцифры (root+intermediate одним файлом). НУЖНО на боевом сервере:
# MAX отдаёт российский сертификат, которому Node по умолчанию не доверяет,
# без этого запросы к API падают с "unable to get local issuer certificate".
# Раскомментируй после установки (см. README):
# NODE_EXTRA_CA_CERTS=/opt/perfecto/russian-ca.pem

# ЛОКАЛЬНАЯ ПРОВЕРКА на своём ПК (НЕ включать на сервере!): обойти сертификат Минцифры
# на время локального теста доставки в MAX. Раскомментируй только для теста:
# NODE_TLS_REJECT_UNAUTHORIZED=0
